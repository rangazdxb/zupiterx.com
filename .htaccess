DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Apache does not ship a MIME type for .glb, so the models would otherwise be
# sent as application/octet-stream. Not fatal, but the correct type lets
# browsers and proxies handle them sensibly.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# Deliberately NOT gzipping .glb: the models already carry meshopt-compressed
# geometry and WebP textures, so a second pass costs CPU for ~no saving.

<IfModule mod_expires.c>
  ExpiresActive On
  # Next emits content-hashed filenames under _next/static, so those can be
  # cached hard — a new build produces new names.
  <FilesMatch "\.(js|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Models and brand art are stable but not hashed; cache for a month.
  <FilesMatch "\.(glb|png|jpe?g|webp|svg)$">
    ExpiresDefault "access plus 30 days"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML must revalidate, otherwise a redeploy is invisible to repeat visitors.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
